# DuoAI — variáveis de ambiente (stack 100% open-source, sem Twilio)

# OmniRoute (gateway de LLM open-source) — github.com/diegosouzapw/OmniRoute
# Instalar e rodar localmente: npm install -g omniroute && omniroute
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_MODEL=auto

# Hermes Agent (NousResearch) — github.com/NousResearch/hermes-agent
# Configurar o Hermes Agent para usar o OmniRoute como provedor de LLM
# (endpoint custom) e habilitar o gateway nativo de WhatsApp do próprio Hermes
# em vez de qualquer integração paga (Twilio).
HERMES_LLM_PROVIDER=custom
HERMES_LLM_BASE_URL=${OMNIROUTE_BASE_URL}
HERMES_WHATSAPP_ENABLED=true

# Servidor DuoAI (frentes B2C/B2B)
PORT=8787

# Link do WhatsApp comercial da LabDuo, usado nas abordagens B2B
DUOAI_WHATSAPP_COMERCIAL=https://wa.me/5500000000000
